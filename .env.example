# Copia este archivo a .env.local y pon los valores de tu proyecto de Supabase
# (Project Settings > API). Usa solo la clave publicable, nunca la secreta.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_tu_clave

# Credenciales del usuario de pruebas para Playwright (npm run test:e2e)
E2E_EMAIL=usuario@ejemplo.test
E2E_PASSWORD=tu_contrasena_e2e

# Solo para npm run db:types, y se pasa en la terminal (no se lee de .env.local):
#   SUPABASE_PROJECT_REF=<ref> npm run db:types
# Sin ella se leen los tipos del proyecto de producción.
# SUPABASE_PROJECT_REF=abcdefghijklmnopqrst
